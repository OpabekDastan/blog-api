# Copy this file to settings/.env and fill in the values.
# BLOG_ENV_ID selects the settings module: settings.env.<BLOG_ENV_ID>
BLOG_ENV_ID=local
BLOG_SECRET_KEY=change-me

# Used only by settings/env/prod.py
BLOG_ALLOWED_HOSTS=example.com,www.example.com
BLOG_DB_NAME=blog
BLOG_DB_USER=postgres
BLOG_DB_PASSWORD=postgres
BLOG_DB_HOST=localhost
BLOG_DB_PORT=5432
